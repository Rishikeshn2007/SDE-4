# SDE-4 Academia AI Voice Co-Pilot - Environment Configuration
# Copy this file to .env and adjust values as needed.
# DO NOT COMMIT SENSITIVE SECRETS OR REAL API KEYS TO VERSION CONTROL.

# Provider Engine ('mock' or 'real')
STT_PROVIDER=mock

# Language & Audio Configuration
STT_LANGUAGE=en-US
STT_SAMPLE_RATE=16000

# Confidence Threshold [0.0 - 1.0] (segments below this trigger LOW_CONFIDENCE flag)
STT_CONFIDENCE_THRESHOLD=0.80

# Resilience & Retries
STT_RETRY_MAX=3
STT_RETRY_TIMEOUT_S=10.0

# Optional Google Cloud Credentials (only needed if using paid Google Cloud STT API)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json
